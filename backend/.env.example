# Local development. Never commit real credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./srs_reviewer.db
UPLOAD_DIR=./uploads
LLM_PROVIDER=mock
GROQ_API_KEY=
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Development recovery mail is written here; production requires SMTP.
MAIL_SINK_DIR=./mail_sink
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
JOB_BACKEND=local
REDIS_URL=redis://localhost:6379/0
JOB_LEASE_SECONDS=90
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900

# AI admission budget and private validated-cache lifetime (0 disables cache)
LLM_RUN_TOKEN_BUDGET=100000
LLM_CACHE_TTL_SECONDS=86400

# Micro-USD budget per run: 1000000 = USD 1; 0 explicitly disables the money cap.
# Set verified prices for the EXACT provider/model before enabling paid AI.
# LLM_PRICING is JSON: {"provider/model":{"input":MICRO_USD_PER_MILLION_INPUT_TOKENS,"output":MICRO_USD_PER_MILLION_OUTPUT_TOKENS}}
LLM_RUN_COST_BUDGET_MICROUSD=1000000
LLM_PRICING={}
LLM_BATCH_INPUT_TOKENS=6000
LLM_BATCH_ITEMS=12
