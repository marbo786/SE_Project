# Copy to backend/.env, then replace both Vercel URLs. Never commit .env.
# Development is intentional: no SMTP is needed and mock is allowed.
APP_ENV=development
COOKIE_SECURE=true
PUBLIC_URL=https://YOUR-PROJECT.vercel.app
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app
LLM_PROVIDER=mock
GROQ_API_KEY=
# Compose overrides database, queue and upload settings with its private services.
JOB_BACKEND=celery
DATABASE_URL=postgresql+psycopg://srs:srs_local_dev@postgres:5432/srs
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/app/uploads
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional Groq: set provider/key/model and verified prices together.
LLM_MODEL=qwen/qwen3.8-27b
LLM_PRICING={}
LLM_RUN_COST_BUDGET_MICROUSD=1000000
