@startuml
actor Librarian
participant LoanService
participant AuthService
participant Catalog
participant Loan

Librarian -> Catalog : searchCatalog(query)
Catalog --> Librarian : matching books
Librarian -> LoanService : recordLoan(bookId, memberId)
LoanService -> AuthService : authenticate(sessionToken)
AuthService --> LoanService : authenticated
LoanService -> Catalog : isBookAvailable()
Catalog --> LoanService : available
LoanService -> Loan : record(bookId, memberId)
Loan --> LoanService : loan
LoanService --> Librarian : loan recorded
@enduml
