@startuml
class Book {
  +title: String
  +available: bool
  +currentLoanId: String
}

class Loan {
  +id: String
  +book: Book
  +librarian: String
  +dueDate: Date
  +record(bookId: String, memberId: String): Loan
}

class Catalog {
  +searchCatalog(query: String): List<Book>
  +isBookAvailable(bookId: String): bool
}

class LoanService {
  +recordLoan(bookId: String, memberId: String): Loan
}

class AuthService {
  +authenticate(sessionToken: String): bool
  +rejectUnauthenticatedRequest(sessionToken: String): void
}

Book "1" -- "0..*" Loan : is lent in
Catalog "1" -- "0..*" Book : lists
LoanService ..> Catalog : uses
LoanService ..> AuthService : uses
LoanService ..> Loan : creates
@enduml
